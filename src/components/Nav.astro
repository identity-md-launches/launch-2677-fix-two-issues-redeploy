---
const { current } = Astro.props;
const links = [
  { href: '/', label: 'Home' },
  { href: '/mint', label: 'Mint' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
];
---
<header class="border-b border-border">
  <nav class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="./index.html" class="brand text-amber font-bold text-sm no-underline"><span aria-hidden="true">🐹</span> SqueekBlockNFT <span class="text-muted text-sm">v1</span></a>
    <div class="nav-links flex text-sm">
      {links.map(({ href, label }) => (
        <a href={href === '/' ? './index.html' : `.${href}.html`} aria-current={current === href ? 'page' : undefined} class={`no-underline ${current === href ? 'text-green' : 'text-muted hover:text-green'}`}>
          {label}
        </a>
      ))}
    </div>
  </nav>
</header>
