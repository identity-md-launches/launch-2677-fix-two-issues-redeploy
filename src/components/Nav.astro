---
const { current } = Astro.props;
const links = [
  { href: '/', label: 'Home' },
  { href: '/mint', label: 'Mint' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
];
---
<header class="border-b border-border">
  <nav class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="text-amber font-bold text-sm no-underline">🐹 SqueekBlockNFT <span class="text-muted text-xs">v1</span></a>
    <div class="flex gap-4 text-xs">
      {links.map(({ href, label }) => (
        <a href={href} class={`no-underline ${current === href ? 'text-green' : 'text-muted hover:text-green'}`}>
          {label}
        </a>
      ))}
    </div>
  </nav>
</header>