---
import Layout from '../layouts/Layout.astro';
import BlockCard from '../components/BlockCard.astro';
---

<Layout 
  title="SqueekBlockNFT · Community block data cards"
  description="Community-made SVG block data cards for SqueekChain on Sepolia testnet. Not affiliated with SqueekChain."
  current="/"
>
<div class="max-w-3xl mx-auto px-4 pt-8 pb-12">
  
  <!-- Hero -->
  <div class="text-center mb-6">
    <h1 class="text-amber text-2xl font-bold mb-3">SqueekBlockNFT</h1>
    <p class="text-muted text-sm max-w-lg mx-auto mb-2">Community-made SVG block data cards for SqueekChain.</p>
    <p class="text-sm text-muted mb-4">Sepolia testnet · 10,000 supply · Gas only</p>
    <div class="flex justify-center gap-3">
      <a href="./mint.html" class="term-btn primary">
        Mint a Block
      </a>
      <a href="./gallery.html" class="term-btn">
        View Gallery
      </a>
    </div>
  </div>

  <!-- The original SVG card design is rendered at build time. -->
  <section class="mb-8" aria-labelledby="sampleHeading">
    <h2 id="sampleHeading" class="section-title">Sample cards</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3" id="sampleCards">
      <BlockCard block={1} round={1} work={11} />
      <BlockCard block={100} round={3} work={1086} />
      <BlockCard block={1000} round={141} work={10941} />
      <BlockCard block={6969} round={894} work={79134} />
    </div>
    <p class="text-sm text-muted mt-2">Examples of the card design, not a list of available blocks.</p>
  </section>

  <section class="mb-8" aria-labelledby="statsHeading">
    <h2 id="statsHeading" class="section-title">Chain stats</h2>
    <div id="chainStats" class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm term-box p-4">
      <div><div class="text-muted mb-1">Block height</div><div class="text-text font-bold text-lg" id="statHeight">Loading…</div></div>
      <div><div class="text-muted mb-1">Total minted</div><div class="text-green font-bold text-lg" id="statMinted">Loading…</div></div>
      <div><div class="text-muted mb-1">Max supply</div><div class="text-text font-bold text-lg">10,000</div></div>
      <div><div class="text-muted mb-1">Network</div><div class="text-amber font-bold text-lg">Sepolia</div></div>
    </div>
    <p id="statsStatus" role="status" class="text-sm text-muted mt-2"></p>
    <button id="retryStats" class="term-btn mt-2" hidden>Retry stats</button>
    <noscript><p class="text-sm text-muted mt-2">Enable JavaScript for live Sepolia stats and wallet interactions.</p></noscript>
  </section>

  <!-- How it works -->
  <div class="mb-8">
    <h2 class="section-title">How it works</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
      <div class="term-box p-4">
        <div class="text-amber font-bold mb-2">01. Connect</div>
        <p class="text-muted">Connect a browser wallet, then switch to Sepolia when prompted.</p>
      </div>
      <div class="term-box p-4">
        <div class="text-amber font-bold mb-2">02. Pick a Block</div>
        <p class="text-muted">Choose a mined block from #1 to #10,000. Check the chain height for availability.</p>
      </div>
      <div class="term-box p-4">
        <div class="text-amber font-bold mb-2">03. Mint & View</div>
        <p class="text-muted">Mint your block data card, then view it in the gallery. Each card shows round, work, and rarity.</p>
      </div>
    </div>
  </div>

  <!-- Why Collect -->
  <div class="mb-8">
    <h2 class="section-title">Why collect?</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
      <div class="term-box p-4">
        <div class="text-amber font-bold mb-1">Early Blocks = Legendary</div>
        <p class="text-muted">Blocks #1–#10 are Legendary. #11–#100 are Epic. Rarity comes from the block number, not when you mint.</p>
      </div>
      <div class="term-box p-4">
        <div class="text-amber font-bold mb-1">Fully On-Chain</div>
        <p class="text-muted">The card’s SVG art is generated on-chain. The website is a separate static export prepared for IPFS.</p>
      </div>
      <div class="term-box p-4">
        <div class="text-amber font-bold mb-1">Milestone Blocks</div>
        <p class="text-muted">Every 1,000th block is a Milestone. Every 100th is Notable. These special blocks mark key moments in the hamster's journey.</p>
      </div>
      <div class="term-box p-4">
        <div class="text-amber font-bold mb-1">Free to Mint</div>
        <p class="text-muted">Only pay Sepolia gas. No mint fee. Connect your wallet, pick a block, mint. Grab some Sepolia ETH from a faucet and start collecting.</p>
      </div>
    </div>
  </div>

  <!-- Contract info -->
  <div class="term-box p-5 text-sm">
    <div class="flex flex-col md:flex-row md:justify-between gap-2">
      <span class="text-muted">Contract: <a href="https://sepolia.etherscan.io/address/0x531497ddc70d634342020b1111C8b1A92873e669" class="text-green underline break-address" target="_blank" rel="noopener noreferrer">0x531497ddc70d634342020b1111C8b1A92873e669</a></span>
      <span class="text-muted">Sepolia testnet deployment</span>
    </div>
  </div>
</div>
</Layout>

<script>
  import '../scripts/home';
</script>
