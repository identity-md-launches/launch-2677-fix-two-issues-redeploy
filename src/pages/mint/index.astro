---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Mint · SqueekBlockNFT" description="Mint community-made SqueekChain block data cards on Sepolia testnet. Not affiliated with SqueekChain." current="/mint">
  <div class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-amber text-2xl font-bold mb-2">Mint a block</h1>
    <p class="text-muted text-sm mb-3">Collect an on-chain SVG card. Minting is free; you pay Sepolia gas.</p>
    <p class="text-sm text-muted mb-6">Testnet only. Need gas? <a href="https://sepolia-faucet.pk910.de/" class="text-green underline" target="_blank" rel="noopener noreferrer">Get Sepolia ETH</a>.</p>
    <section class="term-box p-5 mb-6" aria-label="Mint a block card">
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <button id="connectBtn" class="term-btn primary" aria-haspopup="dialog">Connect wallet</button>
        <button id="disconnectBtn" class="term-btn" hidden>Disconnect</button>
        <span id="walletAddr" class="text-sm text-green" hidden></span>
      </div>
      <p id="walletStatus" role="status" class="status text-sm text-muted mb-4">Connect a browser wallet to mint. Preview cards without connecting.</p>
      <div class="grid grid-cols-2 gap-3 text-sm mb-4">
        <div><span class="text-muted block">Block height</span><span id="chainHeight" class="text-text">Loading…</span></div>
        <div><span class="text-muted block">Total minted</span><span id="chainMinted" class="text-green">Loading…</span></div>
      </div>
      <p id="chainStatus" role="status" class="status text-sm text-muted mb-2"></p>
      <button id="retryChain" class="term-btn mb-4" hidden>Retry chain data</button>
      <form id="mintForm" novalidate>
        <label for="blockNum" class="text-sm block mb-2">Block number (1–10,000)</label>
        <input type="number" id="blockNum" name="block" inputmode="numeric" min="1" max="10000" step="1" value="1" required class="term-input w-full mb-3" aria-describedby="blockHelp mintStatus" />
        <p id="blockHelp" class="text-sm text-muted mb-3">Choose a mined block. Each block can be minted once. Preview opens its art if it has already been minted.</p>
        <div class="flex flex-wrap gap-3">
          <button id="mintBtn" type="submit" class="term-btn" disabled>Mint block</button>
          <button id="previewBtn" type="button" class="term-btn">Preview card</button>
        </div>
        <p id="mintStatus" role="status" class="status text-sm text-muted mt-3"></p>
        <a id="transactionLink" class="text-sm text-green underline break-address" target="_blank" rel="noopener noreferrer" hidden>View transaction on Etherscan</a>
      </form>
      <noscript><p class="text-sm text-muted mt-4">Enable JavaScript to connect a wallet, load cards, and mint.</p></noscript>
    </section>
    <section id="tokenSection" class="mb-6" hidden aria-labelledby="tokenHeading">
      <h2 id="tokenHeading" class="section-title">Token preview</h2>
      <div id="tokenDisplay"></div>
      <p id="tokenCaption" class="text-sm text-muted mt-2 text-center"></p>
    </section>
  </div>
  <dialog id="walletDialog" aria-labelledby="walletHeading">
    <div class="flex justify-between items-center gap-3 mb-3">
      <h2 id="walletHeading" class="text-lg font-bold">Connect a wallet</h2>
      <button id="closeWallet" class="term-btn" aria-label="Close wallet picker">×</button>
    </div>
    <div id="walletList"></div>
    <p id="walletDialogStatus" class="status text-sm text-muted mt-3" role="status"></p>
  </dialog>
</Layout>
<script>
  import '../../scripts/mint';
</script>
