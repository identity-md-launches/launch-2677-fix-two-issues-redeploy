---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Gallery · SqueekBlockNFT" description="Browse community-made SqueekChain SVG block cards on Sepolia. Not affiliated with SqueekChain." current="/gallery">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-amber text-2xl font-bold mb-2">Gallery</h1>
    <p class="text-muted text-sm mb-6">Browse minted block data cards. Select a card to view it full size.</p>
    <form id="rangeForm" class="mb-4">
      <label for="rangeStart" class="text-sm block mb-2">Starting block</label>
      <div class="flex flex-wrap gap-3">
        <input id="rangeStart" name="start" type="number" min="1" max="10000" step="1" value="1" inputmode="numeric" class="term-input flex-1" required aria-describedby="rangeHelp galleryStatus" />
        <button id="loadRange" class="term-btn" type="submit">Load range</button>
      </div>
      <p id="rangeHelp" class="text-sm text-muted mt-2">Browse 50 blocks at a time, up to the current height or block 10,000.</p>
    </form>
    <p id="galleryStatus" role="status" class="status text-sm text-muted mb-3">Reading Sepolia…</p>
    <button id="retryGallery" class="term-btn mb-4" hidden>Retry gallery</button>
    <div id="galleryGrid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mb-6" aria-busy="true"></div>
    <div class="flex flex-wrap gap-3">
      <button id="previousRange" class="term-btn" disabled>Previous 50</button>
      <button id="nextRange" class="term-btn" disabled>Next 50</button>
      <a href="./mint.html" class="term-btn">Mint a block</a>
    </div>
    <noscript><p class="text-sm text-muted mt-4">Enable JavaScript to load the on-chain gallery. You can still <a href="./about.html" class="text-green underline">read about the collection</a>.</p></noscript>
  </div>
  <dialog id="cardDialog" aria-labelledby="cardHeading">
    <div class="flex items-center justify-between gap-3 mb-4">
      <h2 id="cardHeading" class="text-lg font-bold">Block card</h2>
      <button id="closeCard" class="term-btn" aria-label="Close card preview">×</button>
    </div>
    <div id="fullCard"></div>
    <p id="cardRarity" class="text-sm text-muted my-3"></p>
    <a id="viewBlock" href="./mint.html" class="term-btn">View on mint page</a>
  </dialog>
</Layout>
<script>
  import '../../scripts/gallery';
</script>
